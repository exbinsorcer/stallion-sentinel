# Safe example configuration for Stallion Sentinel.
# Do not place real credentials or production values in a committed .env file.

SENTINEL_ENVIRONMENT=development
HOSTLESS_BASE_URL=
HOSTLESS_SSH_HOST=
HOSTLESS_SSH_USER=
HOSTLESS_SSH_PORT=22
HOSTLESS_SSH_KEY_PATH=
SENTINEL_MONITORED_APPS_JSON=[]
SENTINEL_RAM_WARNING_THRESHOLD=75
SENTINEL_RAM_FAILED_THRESHOLD=90
SENTINEL_DISK_WARNING_THRESHOLD=75
SENTINEL_DISK_FAILED_THRESHOLD=90
